# Copy this file to .env and replace every placeholder. Never commit .env.
DATABASE_URL=postgresql+psycopg://brightloop_app:change-me@localhost:5432/brightloop
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
BRIGHTLOOP_SECRET_KEY=replace-with-at-least-64-random-characters
BRIGHTLOOP_ENV=development
BRIGHTLOOP_TOKEN_HOURS=8
BRIGHTLOOP_BILLING_TIMEZONE=Asia/Kolkata
BRIGHTLOOP_CURRENCY=INR
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Optional email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Optional Stripe payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
